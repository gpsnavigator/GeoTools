# Copy to .env (git-ignored) for local development. In GitHub Actions the same names come from
# repository secrets/variables (see README "Deploying to GitHub Pages").

# Mapy.com API key for the outdoor tile layer -- https://developer.mapy.com/
VITE_MAPY_COM_API_KEY=your_mapy_com_api_key_here

# URL of the session-logger Cloudflare Worker (backend/session-logger). Leave empty to keep the
# session log in the browser's localStorage only.
VITE_SESSION_LOG_ENDPOINT=
